{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/purge-deleted-accounts",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/internal/cron/trial-notices",
      "schedule": "0 8 * * *"
    }
  ]
}
