DATABASE_URL =
SECRET_KEY =
ALGORITHM =
ACCESS_TOKEN_EXPIRE_MINUTES =
REFRESH_TOKEN_EXPIRE_DAYS =

CLOUDINARY_NAME =
CLOUDINARY_API_KEY =
CLOUDINARY_API_SECRET =

# Max upload size for post images / branding assets, in megabytes. Optional — defaults to 5.
MAX_UPLOAD_SIZE_MB =

# Comma-separated list of allowed CORS origins. Optional — defaults to the
# current production + local-dev set if unset.
CORS_ORIGINS =

# A hostname ending in this is treated as one of our own tenant subdomains;
# anything else is resolved as a candidate custom domain. Optional — defaults to inko.blog.
PUBLIC_BLOG_BASE_DOMAIN =

# Public application URLs (used in email templates)
PUBLIC_SITE_URL=
ADMIN_STUDIO_URL=
PUBLIC_LOGO_URL=

# SMTP settings
SMTP_SERVER=
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USER=
SMTP_PASSWORD=

# Sender details
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=

# Legacy alias kept for compatibility
EMAIL_FROM=

# Recipient for the marketing site's contact form. Optional — falls back to
# EMAILS_FROM_EMAIL when unset.
CONTACT_NOTIFICATION_EMAIL=