# Backend URL for local dev. Production builds always call /api (rewritten by vercel.json).
VITE_API_URL=
# Public blog origin in dev, for "view post" links. Defaults to http://localhost:5174.
VITE_BLOG_URL=
# Marketing site, linked from the login and auth pages. Defaults to http://localhost:5175.
VITE_SITE_URL=
# Blog origin the About-page live preview loads. Optional — defaults to :5174 in dev,
# otherwise this app's own origin.
VITE_PUBLIC_SITE_URL=
