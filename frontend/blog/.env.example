# Backend URL. Used for tenant resolution, and for every call in dev; production
# API calls go through /api (rewritten by vercel.json).
VITE_API_URL=
# Dev only: on localhost the blog serves {VITE_BLOG_SLUG}.inko.blog. Defaults to myblog.
VITE_BLOG_SLUG=
# Origin of the admin studio; the only origin allowed to send About-page preview drafts.
VITE_ADMIN_STUDIO_URL=
# Target of the "Powered by Inko" footer link. Optional — no link when unset.
VITE_MARKETING_SITE_URL=
